/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "controlwatch",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-08",

	"observability": {
		"enabled": true
	},

	"upload_source_maps": true,

	"compatibility_flags": [
		"nodejs_compat"
	],

	// Workers AI binding
	// This lets our Worker access Workers AI through env.AI
	"ai": {
		"binding": "AI"
	},

	"d1_databases": [
		{
			"binding": "controlwatch_db",
			"database_name": "controlwatch-db",
			"database_id": "244397ae-bf86-46ce-a9dd-b02d87f04dbf"
		}
	],

	"r2_buckets": [
		{
			"bucket_name": "controlwatch-evidence",
			"binding": "controlwatch_evidence"
		}
	]

	/**
	 * Smart Placement
	 */
	// "placement": { "mode": "smart" }

	/**
	 * Environment Variables
	 */
	// "vars": { "MY_VARIABLE": "production_value" }

	/**
	 * Static Assets
	 */
	// "assets": { "directory": "./public/", "binding": "ASSETS" }

	/**
	 * Service Bindings
	 */
	// "services": [
	//   {
	//     "binding": "MY_SERVICE",
	//     "service": "my-service"
	//   }
	// ]
}