/**
 * Cloudflare Worker configuration for ControlWatch
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "controlwatch",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-08",

	"observability": {
		"enabled": true
	},

	"upload_source_maps": true,

	"compatibility_flags": [
		"nodejs_compat"
	],

	// Workers AI
	"ai": {
		"binding": "AI"
	},

	// D1 database
	"d1_databases": [
		{
			"binding": "controlwatch_db",
			"database_name": "controlwatch-db",
			"database_id": "244397ae-bf86-46ce-a9dd-b02d87f04dbf"
		}
	],

	// R2 evidence storage
	"r2_buckets": [
		{
			"bucket_name": "controlwatch-evidence",
			"binding": "controlwatch_evidence"
		}
	],

	// Static dashboard files.
	//
	// Requests for /api/* go to index.ts first.
	// Everything else, such as /, /style.css and /app.js,
	// is served from the public folder.
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	}
}